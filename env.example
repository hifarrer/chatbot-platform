# ChatBot Platform Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development

# Encryption key for secrets stored in the database (Stripe secret key / webhook secret).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be the SAME value in every environment that touches this database.
# If it is missing, the app still starts but Stripe payments are disabled and
# saving a Stripe key in the admin UI fails with an error.
SETTINGS_ENCRYPTION_KEY=your-fernet-key-here

# Database Configuration (optional - defaults to SQLite)
# DATABASE_URL=sqlite:///chatbot_platform.db

# Upload Configuration
MAX_CONTENT_LENGTH=16777216
# ---------------------------------------------------------------------------
# File storage (Bunny.net Edge Storage)
#
# Leave every BUNNY_* variable unset to use local folders for development.
# Setting SOME of them but not all is a boot error, deliberately: silently
# falling back to the container filesystem is how a previous release deleted
# customer documents on every deploy.
#
# Two zones, because attaching a Pull Zone makes an ENTIRE storage zone
# publicly readable. Avatars need that (browsers on customer sites fetch them);
# uploaded documents and knowledge bases must never have it.
# ---------------------------------------------------------------------------
# Region host of your storage zones. Pick the one matching the zone's region:
#   storage.bunnycdn.com (Falkenstein/DE, default)   ny.  la.  uk.
#   se.  br.  sg.  syd.  jh.   (all .storage.bunnycdn.com)
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# PUBLIC zone - avatars. Attach a Pull Zone to this one.
BUNNY_PUBLIC_ZONE=owlbee-public
BUNNY_PUBLIC_ACCESS_KEY=
# The Pull Zone hostname. Without it avatars are proxied through Flask, which
# works but spends your instance's bandwidth on every widget load.
BUNNY_PUBLIC_CDN_URL=

# PRIVATE zone - uploaded documents and knowledge bases. NO Pull Zone.
BUNNY_PRIVATE_ZONE=owlbee-private
BUNNY_PRIVATE_ACCESS_KEY=

# Use the storage zone PASSWORD for the access keys (Storage Zone -> FTP & API
# Access), not your account API key.

# Optional tuning
# BUNNY_STORAGE_HOST_PRIVATE=      # only if the two zones are in different regions
# BUNNY_CONNECT_TIMEOUT=5
# BUNNY_READ_TIMEOUT=30
# BUNNY_ATTEMPTS=3
# BUNNY_CHAT_READ_TIMEOUT=8        # artifact fetch during a visitor's chat request

# Local development only, ignored when Bunny is configured
# LOCAL_STORAGE_PUBLIC_DIR=static/uploads
# LOCAL_STORAGE_PRIVATE_DIR=uploads

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=True 